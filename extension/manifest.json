{
  "manifest_version": 3,
  "name": "Pointmaxing",
  "description": "Viser hvor mange EuroBonus-poeng nettbutikken du er inne på gir via Trumf, Klarna og SAS Online Shopping.",
  "version": "0.2.0",
  "icons": {
    "16": "ikon16.png",
    "48": "ikon48.png",
    "128": "ikon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://pointmaxing.no/*",
    "http://pointmaxing.no/*"
  ],
  "background": {
    "service_worker": "bakgrunn.js"
  },
  "action": {
    "default_title": "Pointmaxing",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "ikon16.png",
      "48": "ikon48.png",
      "128": "ikon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.no/search*",
        "https://www.google.se/search*",
        "https://www.google.dk/search*"
      ],
      "js": [
        "sok.js"
      ],
      "css": [
        "sok.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
